# Copy to .env and fill in. NEVER commit the real .env.
DATABASE_URL="postgresql://trovework:trovework@localhost:5432/trovework?schema=public"

# Generate each with:  openssl rand -base64 48
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-differently"

# Field-level encryption for ID PII at rest (NFR-SEC-2). 32 bytes, hex or base64.
# Generate with:  openssl rand -hex 32
# WARNING: rotating this makes existing encrypted ID records unreadable.
PII_ENCRYPTION_KEY="change-me-32-bytes-hex-or-base64"

ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"
# How long a password-reset link stays valid.
PASSWORD_RESET_TTL="1h"

# SMTP for sending password-reset email. Leave SMTP_USER/SMTP_PASS blank to just
# log the reset link (dev). For Gmail, SMTP_PASS must be an App Password
# (Google account -> Security -> 2-Step Verification -> App passwords), NOT your
# normal password. Port 465 = implicit TLS, 587 = STARTTLS.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Cookies are marked Secure unless this is "development"
NODE_ENV="development"
PORT=4000
WEB_ORIGIN="http://localhost:3000"

# Comma-separated emails auto-promoted to admin on login (bootstraps the first admin).
ADMIN_EMAILS=""

# Google OAuth 2.0. Leave blank to disable "Continue with Google" (the routes
# return 503). Create credentials at https://console.cloud.google.com/apis/credentials
# with the authorized redirect URI matching GOOGLE_CALLBACK_URL below.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

# File storage. PUBLIC_DIR holds profile photos (served by nginx at PUBLIC_URL_BASE);
# SECURED_DIR holds ID images and selfies and must NEVER be web-served.
PUBLIC_DIR="./storage"
PUBLIC_URL_BASE="/uploads"
SECURED_DIR="./secured"

# ID verification engine. "auto" enables face-match (face-api.js/WASM) + OCR;
# any other value = manual admin review only. The auto engine has NO liveness
# check and always falls back to manual review on any error, so it never blocks
# or auto-approves unsafely. Thresholds are on a 0..1 face-similarity score.
ID_VERIFY_ENGINE="manual"
ID_VERIFY_VERIFY_MIN="0.6"
ID_VERIFY_REJECT_MAX="0.4"
