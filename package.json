{
  "name": "trovework",
  "version": "0.1.0",
  "private": true,
  "description": "Trovework \u2014 a trust-first global freelance marketplace",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "dev:api": "npm run dev --workspace=api",
    "build": "npm run build --workspace=web && npm run build --workspace=api",
    "build:web": "npm run build --workspace=web",
    "build:api": "npm run build --workspace=api",
    "start": "npm run start --workspace=web",
    "lint": "npm run lint --workspace=web",
    "test": "npm run test --workspace=api"
  },
  "engines": {
    "node": ">=20"
  }
}
