# Copy to .env and fill in. NEVER commit the real .env.
DATABASE_URL="postgresql://trovework:trovework@localhost:5432/trovework?schema=public"

# Generate each with:  openssl rand -base64 48
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-differently"

ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"
# How long a password-reset link stays valid.
PASSWORD_RESET_TTL="1h"

# Cookies are marked Secure unless this is "development"
NODE_ENV="development"
PORT=4000
WEB_ORIGIN="http://localhost:3000"

# Comma-separated emails auto-promoted to admin on login (bootstraps the first admin).
ADMIN_EMAILS=""

# File storage. PUBLIC_DIR holds profile photos (served by nginx at PUBLIC_URL_BASE);
# SECURED_DIR holds ID images and selfies and must NEVER be web-served.
PUBLIC_DIR="./storage"
PUBLIC_URL_BASE="/uploads"
SECURED_DIR="./secured"
